# Banco de dados
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# URL pública/local da aplicação usada nas URLs de retorno do checkout
APP_URL="http://localhost:3000"

# Segurança do OTP - use uma string longa e aleatória em produção
OTP_HASH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# SMTP para envio do código OTP
# Porta 587 usa STARTTLS; porta 465 usa TLS direto.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_USER="usuario-smtp"
SMTP_PASSWORD="senha-smtp"
SMTP_FROM="PC Gamer <no-reply@example.com>"

# WhatsApp com DDI + DDD + número, somente dígitos
NEXT_PUBLIC_WHATSAPP_NUMBER="5599999999999"

# Mercado Pago - use credenciais de TESTE durante o desenvolvimento
MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxx"
MP_USE_SANDBOX="true"

# Webhook: deve ser uma URL HTTPS pública (ex.: túnel ngrok/cloudflared em desenvolvimento)
# Exemplo: https://seu-tunel.ngrok-free.app/api/webhooks/mercado-pago
MP_WEBHOOK_URL=""
MP_WEBHOOK_SECRET=""

# Painel agregado de analytics (minimo de 32 caracteres, nunca NEXT_PUBLIC_)
ANALYTICS_ADMIN_TOKEN="substitua-por-chave-secreta-com-mais-de-32-caracteres"

# Analytics de visitantes (IDs públicos; configure nos respectivos painéis)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
# Envio de alertas de erro (secreto, somente backend)
DISCORD_ERROR_WEBHOOK_URL=""
# Segredo dos links de comprovante em PDF (mínimo 32 caracteres)
RECEIPT_SIGNING_SECRET=""

# Opcional: armazenamento de eventos de erro sanitizados no Google Drive
# Compartilhe uma pasta com o e-mail da conta de serviço e habilite a API Drive
GOOGLE_DRIVE_LOG_FOLDER_ID=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""

